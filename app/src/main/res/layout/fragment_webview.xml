<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/medalert_bg"
    android:orientation="vertical">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:text="Tips Pertolongan Pertama"
            android:textColor="@color/medalert_blue"
            android:textSize="17sp" />
    </FrameLayout>

    <!-- Garis loading halaman -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        app:indicatorColor="@color/medalert_red"
        app:trackColor="@color/medalert_red_track"
        app:trackThickness="3dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:padding="24dp"
            android:text="Halaman tidak bisa dimuat.\nPeriksa koneksi internet kamu."
            android:textColor="@color/medalert_gray"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
