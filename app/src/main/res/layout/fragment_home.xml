<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- HEADER GELOMBANG (bg_header_wave) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_wave"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="56dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Halo"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Tetap tenang, bantuan ada di sini."
                    android:textColor="#C9D3E3"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_white"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="RA"
                android:textColor="@color/medalert_blue"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Kartu status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/medalert_green_light"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/dot_teal"
                android:drawablePadding="10dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Data medis lengkap  ·  3 kontak darurat"
                android:textColor="#1F7A6F"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- TOMBOL SOS -->
        <TextView
            android:id="@+id/tvSos"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sos"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="SOS"
            android:textColor="#FFFFFF"
            android:textSize="42sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:text="Tekan tombol SOS saat keadaan darurat"
            android:textColor="@color/medalert_blue"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/inter_regular"
            android:text="Ada hitung mundur 5 detik, bisa dibatalkan"
            android:textColor="@color/medalert_gray"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Akses Cepat"
            android:textColor="@color/medalert_blue"
            android:textSize="15sp" />

        <!-- GRIDLAYOUT: 6 menu dalam 3 kolom -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridQuick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            app:columnCount="3">

        <LinearLayout
            android:id="@+id/cardCall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_pink_circle"
                android:contentDescription="Telepon\n112"
                android:padding="9dp"
                android:src="@drawable/ic_phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="Telepon\n112"
                android:textColor="@color/medalert_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAmbulance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_pink_circle"
                android:contentDescription="Ambulans\n119"
                android:padding="9dp"
                android:src="@drawable/ic_cross" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="Ambulans\n119"
                android:textColor="@color/medalert_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardFaskes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_teal_circle"
                android:contentDescription="Faskes\nTerdekat"
                android:padding="9dp"
                android:src="@drawable/ic_pin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="Faskes\nTerdekat"
                android:textColor="@color/medalert_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardPolice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_navy_circle"
                android:contentDescription="Polisi\n110"
                android:padding="9dp"
                android:src="@drawable/ic_shield" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="Polisi\n110"
                android:textColor="@color/medalert_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardFire"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_pink_circle"
                android:contentDescription="Pemadam\n113"
                android:padding="9dp"
                android:src="@drawable/ic_flame" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="Pemadam\n113"
                android:textColor="@color/medalert_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardTips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_teal_circle"
                android:contentDescription="Tips\nP3K"
                android:padding="9dp"
                android:src="@drawable/ic_info"
                android:tint="@color/medalert_teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="Tips\nP3K"
                android:textColor="@color/medalert_blue"
                android:textSize="12sp" />
        </LinearLayout>
        </androidx.gridlayout.widget.GridLayout>
    </LinearLayout>
</ScrollView>
